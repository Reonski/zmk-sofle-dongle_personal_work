#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>
#include <behaviors/runtime-sensor-rotate.dtsi>

/ {
    zip_scroll_scaler: zip_scroll_scaler {
        compatible = "zmk,input-processor-scaler";
        #input-processor-cells = <2>;
        type = <INPUT_EV_REL>;
        codes = <INPUT_REL_WHEEL INPUT_REL_HWHEEL>;
        track-remainders;
    };
};

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 6 1>; }; // ori: 2 1 (works pefectly with smooth scrolling=y)

&msc {
    acceleration-exponent = <0>;      // 0
    time-to-max-speed-ms = <0>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <400>;
    acceleration-exponent = <1>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    behaviors {
        rsr_vol: rsr_vol {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp C_VOL_UP>;
            ccw-binding = <&kp C_VOL_DN>;
        };

        rsr_trans: rsr_trans {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <0>;
        };
    };

    macros {
        Court_Yes: Court_Yes {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(C) &kp LS(Y) &kp E &kp S>;
            label = "COURT_YES";
        };

        agree_ag: agree_ag {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp A &kp G>;
            label = "AGREE_AG";
        };

        disagree_dg: disagree_dg {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp D &kp G>;
            label = "DISAGREE_DG";
        };

        your_honour: your_honour {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp Y &kp H>;
            label = "YOUR_HONOUR";
        };

        agreement: agreement {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp A &kp G &kp M &kp T>;
            label = "AGREEMENT";
        };

        witness: witness {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp W &kp I &kp T &kp N>;
            label = "WITNESS";
        };

        witnesses: witnesses {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp W &kp I &kp T &kp N &kp S>;
            label = "WITNESSES";
        };

        space_backspace: space_backspace {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp SPACE &kp BACKSPACE>;
            label = "SPACE_BACKSPACE";
        };

        bold_italics: bold_italics {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp LC(B) &kp LC(I)>;
            label = "BOLD_ITALICS";
        };

        ok: ok {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp O &kp K>;
            label = "OK";
        };

        r8: r8 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp R &kp N8>;
            label = "R8";
        };

        a8: a8 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp A &kp N8>;
            label = "A8";
        };

        yk: yk {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp Y &kp K>;
            label = "YK";
        };

        num_yes: num_yes {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp Y &kp E &kp S>;
            label = "NUM_YES";
        };

        num_yah: num_yah {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp Y &kp A>;
            label = "NUM_YAH";
        };

        num_no: num_no {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp N &kp O>;
            label = "NUM_NO";
        };

        num_sorry: num_sorry {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp S &kp Y>;
            label = "NUM_SORRY";
        };

        num_Now: num_Now {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp N &kp W>;
            label = "NUM_NOW";
        };

        num_so: num_so {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp S &kp O>;
            label = "NUM_SO";
        };

        num_ty: num_ty {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp T &kp Y>;
            label = "NUM_TY";
        };

        sticky_space: sticky_space {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp LS(LC(SPACE))>;
            label = "STICKY_SPACE";
        };

        num_cr: num_cr {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp C &kp R>;
            label = "NUM_CR";
        };

        num_sir: num_sir {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp S &kp I &kp R>;
            label = "NUM_SIR";
        };

        num_the: num_the {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp T &kp H &kp E>;
            label = "NUM_THE";
        };

        numpad_is: numpad_is {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp I &kp S>;
            label = "NUMPAD_IS";
        };

        wer_shortcut: wer_shortcut {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp W &kp E &kp R>;
            label = "WER_SHORTCUT";
        };

        rew_shortcut: rew_shortcut {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp R &kp E &kp W>;
            label = "REW_SHORTCUT";
        };

        sdf_shortcut: sdf_shortcut {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp S &kp D &kp F>;
            label = "SDF_SHORTCUT";
        };

        fds_shortcut: fds_shortcut {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp F &kp D &kp S>;
            label = "FDS_SHORTCUT";
        };

        can_numpad: can_numpad {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp C &kp A &kp N>;
            label = "CAN_NUMPAD";
        };

        sure_numpad: sure_numpad {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp S &kp U &kp R &kp E>;
            label = "SURE_NUMPAD";
        };

        del_bold_numpad: del_bold_numpad {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp D &kp E &kp L &kp SPACE &kp BACKSPACE>;
            label = "DEL_BOLD_NUMPAD";
        };

        numpad_and: numpad_and {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp A &kp N &kp D>;
            label = "NUMPAD_AND";
        };

        numpad_im: numpad_im {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp I &kp M>;
            label = "NUMPAD_IM";
        };

        you_numpad: you_numpad {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp Y &kp O &kp U>;
            label = "YOU_NUMPAD";
        };
    };

    combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <14 28 40>;

        Court_Yes {
            bindings = <&Court_Yes>;
            key-positions = <31 44 0>;
            layers = <0 1>;
        };

        your_honour {
            bindings = <&your_honour>;
            key-positions = <20 33>;
            layers = <0 1>;
        };

        agree {
            bindings = <&agree_ag>;
            key-positions = <27 31>;
            layers = <1>;
        };

        disagree {
            bindings = <&disagree_dg>;
            key-positions = <29 31>;
            layers = <1>;
        };

        agreement {
            bindings = <&agreement>;
            key-positions = <27 18 31>;
            layers = <0>;
        };

        witness {
            bindings = <&witness>;
            key-positions = <15 18>;
            layers = <1>;
        };

        witnesses {
            bindings = <&witnesses>;
            key-positions = <15 18 28>;
            layers = <1>;
        };

        space_backspace {
            bindings = <&space_backspace>;
            key-positions = <59 12>;
            layers = <0 1>;
        };

        fullscreen_shot {
            bindings = <&kp LG(PRINTSCREEN)>;
            key-positions = <56 5>;
            layers = <0>;
        };

        keyboard.ctrl {
            bindings = <&mo 4>;
            key-positions = <62 56>;
        };

        ok {
            bindings = <&ok>;
            key-positions = <23 35>;
            layers = <1>;
        };

        r8 {
            bindings = <&r8>;
            key-positions = <17 9>;
            layers = <1 0>;
        };

        a8 {
            bindings = <&a8>;
            key-positions = <27 9>;
            layers = <1 0>;
        };

        yk {
            bindings = <&yk>;
            key-positions = <20 35>;
            layers = <0 1>;
        };

        num_yes {
            bindings = <&num_yes>;
            key-positions = <20 28>;
            layers = <1>;
        };

        num_no {
            bindings = <&num_no>;
            key-positions = <46 23>;
            layers = <1>;
        };

        num_sorry {
            bindings = <&num_sorry>;
            key-positions = <28 20 17>;
            layers = <1 0>;
        };

        num_Now {
            bindings = <&num_Now>;
            key-positions = <46 15>;
            layers = <1 0>;
        };

        num_yah {
            bindings = <&num_yah>;
            key-positions = <20 27>;
            layers = <1>;
        };

        num_so {
            bindings = <&num_so>;
            key-positions = <28 23>;
            layers = <1>;
        };

        num_ty {
            bindings = <&num_ty>;
            key-positions = <18 20>;
            layers = <1 0>;
        };

        sticky_space {
            bindings = <&sticky_space>;
            key-positions = <57 59>;
            layers = <0 1>;
        };

        num_cr {
            bindings = <&num_cr>;
            key-positions = <42 17>;
            layers = <1 0>;
        };

        num_sir {
            bindings = <&num_sir>;
            key-positions = <28 22 17>;
            layers = <1 0>;
        };

        num_the {
            bindings = <&num_the>;
            key-positions = <18 33>;
            layers = <1>;
        };

        num_is {
            bindings = <&numpad_is>;
            key-positions = <22 28>;
            layers = <1>;
        };

        wer_numpad {
            bindings = <&wer_shortcut>;
            key-positions = <15 16 17>;
            layers = <1>;
        };

        rew_numpad {
            bindings = <&rew_shortcut>;
            key-positions = <16 17 18>;
            layers = <1>;
        };

        sdf_numpad {
            bindings = <&sdf_shortcut>;
            key-positions = <28 29 30>;
            layers = <1>;
        };

        fds_numpad {
            bindings = <&fds_shortcut>;
            key-positions = <29 30 31>;
            layers = <1>;
        };

        can_numpad {
            bindings = <&can_numpad>;
            key-positions = <42 27 46>;
            layers = <1>;
        };

        sure_numpad {
            bindings = <&sure_numpad>;
            key-positions = <28 17 21>;
            layers = <1>;
        };

        del_bold_numpad {
            bindings = <&del_bold_numpad>;
            key-positions = <51 29>;
            layers = <1>;
        };

        numpad_and {
            bindings = <&numpad_and>;
            key-positions = <39 8>;
            layers = <1>;
        };

        numpad_im {
            bindings = <&numpad_im>;
            key-positions = <22 47>;
            layers = <1>;
        };

        you_numpad {
            bindings = <&you_numpad>;
            key-positions = <20 21>;
            layers = <1>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        qwerty {
            bindings = <
&kp ESC     &kp N1     &kp N2        &kp N3        &kp N4  &kp N5         &kp UP_ARROW     &kp N6     &kp N7     &kp N8     &kp N9   &kp N0    &kp BACKSPACE
&kp TAB     &kp Q      &kp W         &kp E         &kp R   &kp T          &kp DOWN_ARROW   &kp Y      &kp U      &kp I      &kp O    &kp P     &kp MINUS
&kp CAPS    &kp A      &kp S         &kp D         &kp F   &kp G          &kp LEFT_ARROW   &kp H      &kp J      &kp K      &kp L    &kp SEMI  &kp APOS
&kp LSHFT   &kp Z      &kp X         &kp C         &kp V   &kp B          &kp RIGHT_ARROW  &kp N      &kp M      &kp COMMA  &kp DOT  &kp FSLH  &mt RIGHT_SHIFT DEL
&kp C_MUTE  &kp LCTRL  &kp LEFT_GUI  &kp LEFT_ALT  &mo 1   &lt 2 SPACE    &mt LC(V) LC(C)  &kp SPACE  &kp ENTER  &none      &mo 3    &tog 1
            >;

            sensor-bindings = <&scroll_encoder>;
            display-name = "qwerty";
        };

        shortcut-numpad {
            bindings = <
&kp GRAVE       &kp LC(LEFT_BRACKET)  &kp LC(RIGHT_BRACKET)  &kp LS(F3)    &none             &kp BACKSPACE       &kp LC(UP_ARROW)    &kp LC(X)  &kp COMMA  &kp PERIOD         &kp QUESTION   &kp EQUAL         &kp BACKSPACE
&kp TAB         &none                 &kp COMMA              &kp PERIOD    &kp LS(QUESTION)  &kp SINGLE_QUOTE    &kp LC(DOWN_ARROW)  &kp LC(C)  &kp HOME   &kp UP_ARROW       &kp PG_UP      &kp BACKSLASH     &kp MINUS
&none           &kp LC(Y)             &kp LC(S)              &kp ENTER     &kp INSERT        &none               &kp LC(LEFT_ARROW)  &kp LC(V)  &kp LEFT   &tog 1             &kp RIGHT      &kp LEFT_BRACKET  &kp RIGHT_BRACKET
&kp LEFT_SHIFT  &kp LC(Z)             &kp LC(X)              &kp LC(C)     &kp LC(V)         &kp LA(B)           &kp LC(RIGHT)       &kp INS    &kp END    &kp DOWN           &kp PAGE_DOWN  &trans            &mt RIGHT_SHIFT DELETE
&trans          &kp LEFT_CONTROL      &kp LEFT_WIN           &kp LEFT_ALT  &none             &trans              &mt LC(V) LC(C)     &trans     &trans     &kp RIGHT_CONTROL  &trans         &none
            >;

            display-name = "shortcut-numpad";
            sensor-bindings = <&scroll_encoder>;
        };

        macros-func. {
            bindings = <
&kp LC(NUMBER_1)      &kp LC(NUMBER_2)      &kp LC(NUMBER_3)      &kp LC(NUMBER_4)      &kp LC(N5)         &kp LC(NUMBER_6)        &kp UP_ARROW  &kp F1             &kp F2             &kp F3            &kp F4            &kp F5         &kp F6
&kp LC(LA(NUMBER_1))  &kp LC(LA(NUMBER_2))  &kp LC(LA(NUMBER_3))  &kp LC(LA(NUMBER_4))  &kp LC(LA(N5))     &kp LC(LA(NUMBER_6))    &kp DOWN      &kp F7             &kp F8             &kp F9            &kp F10           &kp F11        &kp F12
&kp LC(GRAVE)         &none                 &kp LA(GRAVE)         &kp LC(LA(GRAVE))     &kp LA(LS(GRAVE))  &none                   &kp LEFT      &none              &kp LA(NUMBER_1)   &kp LA(NUMBER_2)  &kp LA(NUMBER_3)  &none          &none
&kp LC(KP_N7)         &kp LC(KP_N8)         &kp LC(LA(KP_N7))     &kp LC(LA(KP_N8))     &kp LC(KP_N9)      &none                   &kp RIGHT     &kp LC(LA(KP_N6))  &kp LA(LC(KP_N9))  &none             &none             &none          &kp RSHIFT
&none                 &kp LCTRL             &none                 &kp LEFT_ALT          &trans             &none                   &none         &none              &none              &kp RCTRL         &none             &kp RIGHT_ALT
            >;

            display-name = "macros-func.";
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        shortcut.2 {
            bindings = <
&trans  &trans  &trans         &trans         &trans         &trans           &trans  &trans  &trans         &trans         &trans  &trans  &trans
&trans  &trans  &trans         &trans         &trans         &trans           &trans  &trans  &trans         &bold_italics  &trans  &trans  &kp LC(LS(MINUS))
&trans  &trans  &kp LC(RA(S))  &trans         &trans         &trans           &trans  &trans  &trans         &trans         &trans  &trans  &trans
&trans  &trans  &kp LC(LA(X))  &kp LC(LA(C))  &kp LC(LS(V))  &kp LC(LS(B))    &trans  &trans  &kp LC(LA(M))  &trans         &trans  &trans  &trans
&trans  &trans  &trans         &trans         &trans         &trans           &trans  &trans  &trans         &trans         &trans  &trans
            >;

            display-name = "shortcut.2";
        };

        keyboard.ctrl {
            bindings = <
&kp TILDE  &bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4      &kp UP_ARROW     &kp F6  &kp F7  &kp F8      &kp F9     &kp F10      &trans
&trans     &bt BT_CLR    &bt BT_CLR_ALL  &trans        &trans        &trans            &kp DOWN         &trans  &trans  &kp F11     &kp F12    &kp UNDER    &kp PLUS
&trans     &out OUT_USB  &out OUT_BLE    &trans        &trans        &trans            &kp LEFT         &trans  &trans  &trans      &trans     &kp LBRC     &kp RBRC
&trans     &sys_reset    &trans          &bootloader   &trans        &trans            &kp RIGHT        &trans  &trans  &sys_reset  &soft_off  &bootloader  &trans
&trans     &trans        &trans          &trans        &trans        &kp KP_NUMLOCK    &mt LC(V) LC(C)  &trans  &trans  &trans      &trans     &trans
            >;

            display-name = "keyboard.ctrl";
            sensor-bindings = <&scroll_encoder>;
        };

        layer_1 {
            bindings = <
&kp GRAVE   &kp F1           &kp F2          &kp F3           &kp F4           &kp F5             &mmv MOVE_UP     &kp F6           &kp F7           &kp F8      &kp F9     &kp F10           &trans
&trans      &kp GRAVE        &mkp LCLK       &mkp MCLK        &mkp RCLK        &mkp MB4           &mmv MOVE_DOWN   &kp PG_UP        &kp END          &kp UP      &kp HOME   &kp MINUS         &kp EQUAL
&trans      &kp TILDE        &trans          &trans           &trans           &mkp MB5           &mmv MOVE_LEFT   &kp PG_DN        &kp LEFT         &kp DOWN    &kp RIGHT  &kp LEFT_BRACKET  &kp RIGHT_BRACKET
&trans      &rgb_ug RGB_OFF  &rgb_ug RGB_ON  &rgb_ug RGB_EFF  &rgb_ug RGB_EFR  &rgb_ug RGB_SPI    &mmv MOVE_RIGHT  &rgb_ug RGB_BRI  &rgb_ug RGB_BRD  &kp INSERT  &kp F11    &kp F12           &trans
&kp C_MUTE  &trans           &trans          &trans           &trans           &trans             &mkp LCLK        &trans           &trans           &trans      &trans     &trans
            >;

            display-name = "layer1";
            sensor-bindings = <&scroll_encoder>;
        };
    };
};
